# ═══════════════════════════════════════════════════════════════════
# Variables de entorno — MORE Landing
#
# DESTINO: Dokploy (build-time) + .env local
# Las VITE_* se embeben en el bundle de Vite al momento del build.
# Si falta alguna en Dokploy, el frontend NO la tendrá en producción.
# ═══════════════════════════════════════════════════════════════════

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_MASTERCLASS_REGISTER_URL=https://your-project.supabase.co/functions/v1/masterclass-register

# ═══════════════════════════════════════════════════════════════════
# Secrets de Supabase Edge Functions (runtime)
#
# DESTINO: Supabase secrets — NO van en Dokploy ni en el frontend.
# Configurar con: npx supabase secrets set KEY=value
# ═══════════════════════════════════════════════════════════════════

# Gemini AI (usado por Edge Function de generación de landings)
#   npx supabase secrets set GEMINI_API_KEY=your-gemini-api-key

# GoHighLevel — Masterclass registration
#   npx supabase secrets set GHL_API_KEY=your-ghl-private-integration-token
#   npx supabase secrets set GHL_LOCATION_ID=your-location-id
#   npx supabase secrets set GHL_PIPELINE_ID=your-pipeline-id
#   npx supabase secrets set GHL_STAGE_ID=your-stage-id
#   npx supabase secrets set GHL_TAG=Webinar-EB2NIW-2026
