# Supabase (crear proyecto en https://supabase.com y copiar valores)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Masterclass — URL de la Edge Function de registro
VITE_MASTERCLASS_REGISTER_URL=https://your-project.supabase.co/functions/v1/masterclass-register

# ── Secrets de Supabase Edge Functions ──
# NO van en el frontend. Configurar con:
#   supabase secrets set KEY=value

# Gemini AI
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key

# GoHighLevel (Masterclass registration)
#   supabase secrets set GHL_API_KEY=your-ghl-private-integration-token
#   supabase secrets set GHL_LOCATION_ID=YF36RPtJ1lRQBqM7Qxgc
#   supabase secrets set GHL_PIPELINE_ID=7ZPmVRAHDoASbk9XEoVD
#   supabase secrets set GHL_STAGE_ID=your-stage-id
#   supabase secrets set GHL_TAG=Webinar-EB2NIW-2026
